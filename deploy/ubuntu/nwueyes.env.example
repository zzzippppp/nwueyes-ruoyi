# 此文件复制到 /etc/nwueyes/nwueyes.env，填写真实值后 chmod 640。
# systemd EnvironmentFile 使用 KEY=VALUE 格式；值中不要写未转义的空格。

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/nwueyes
SPRING_DATASOURCE_USERNAME=nwueyes
SPRING_DATASOURCE_PASSWORD=replace-with-a-long-database-password
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=replace-with-a-long-redis-password
TOKEN_SECRET=replace-with-a-random-32-byte-or-longer-secret

NWUEYES_DATA_DIR=/opt/nwueyes/data
NWUEYES_UPLOAD_PATH=/opt/nwueyes/data/uploadPath
PRESENCE_STORAGE_ROOT=/opt/nwueyes/data
PRESENCE_WORKSPACE_ROOT=/opt/nwueyes/ruoyi
PRESENCE_REPLAY_PROFILE_ROOT=/opt/nwueyes/data/uploadPath
PRESENCE_PYTHON=/opt/nwueyes/ruoyi/.venv/bin/python
PRESENCE_INGEST_BASE_URL=http://127.0.0.1:8080
PRESENCE_INGEST_API_KEY=replace-with-a-long-random-ingest-key
# 每日 cleanup-ring 同时删除超过 N 天的场景 mp4；0 或不设则只清 _ring
CLIP_MAX_AGE_DAYS=7

EZVIZ_APP_KEY=
EZVIZ_APP_SECRET=
DASHSCOPE_API_KEY=

GO2RTC_AUTO_START=false
GO2RTC_BASE_URL=http://127.0.0.1:1984
# Nginx exposes this path to browser clients. Replace with your HTTPS domain.
GO2RTC_PUBLIC_BASE_URL=https://your-domain.example/go2rtc
GO2RTC_RTSP_BASE_URL=rtsp://127.0.0.1:8554
